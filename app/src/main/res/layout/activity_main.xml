<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wl_background">

    <!-- ================================================================ -->
    <!-- 1. TOP HEADER (WORLD LENS | + New Chat | ● LIVE | ⚙ Settings)     -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Project Title -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WORLD LENS"
            android:textColor="@color/wl_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- + New Chat Button (Wireframe Center-Top) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/newChatTopButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ New Chat"
            android:textColor="@color/wl_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_button"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="yes"
            android:contentDescription="Start new chat and reset conversation" />

        <!-- ● LIVE Indicator Badge -->
        <TextView
            android:id="@+id/liveStatusIndicator"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="● LIVE"
            android:textColor="@color/wl_text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_live_badge"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="yes"
            android:contentDescription="Camera is live and ready" />

        <!-- ⚙ Settings Gear Button -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="Settings and Model Info"
            app:tint="@color/wl_icon_tint_dark" />
    </LinearLayout>

    <!-- ================================================================ -->
    <!-- 2. DOMINANT LIVE CAMERA VIEW (Wireframe Center Area)              -->
    <!-- ================================================================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cameraCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="@color/wl_surface"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/wl_divider"
        app:cardElevation="2dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/responsePreviewCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Live Camera Preview" />
    </com.google.android.material.card.MaterialCardView>

    <!-- STARTUP / MODEL LOADING BANNER -->
    <LinearLayout
        android:id="@+id/loadingStateContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="@id/cameraCard"
        app:layout_constraintStart_toStartOf="@id/cameraCard"
        app:layout_constraintEnd_toEndOf="@id/cameraCard">

        <ProgressBar
            android:id="@+id/loadingProgressBar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/wl_primary"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/loadingStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Preparing offline AI..."
            android:textColor="@color/wl_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- INLINE ERROR BANNER -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/errorStateContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/wl_surface"
        app:strokeColor="@color/wl_alert"
        app:strokeWidth="1.5dp"
        app:cardCornerRadius="16dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@id/cameraCard"
        app:layout_constraintStart_toStartOf="@id/cameraCard"
        app:layout_constraintEnd_toEndOf="@id/cameraCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Could not understand the current view."
                android:textColor="@color/wl_alert"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Try Again"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                android:backgroundTint="@color/wl_primary"
                android:textColor="@color/wl_text_on_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================================================================ -->
    <!-- 3. FLOATING AI RESPONSE PREVIEW (Above Bottom Controls)           -->
    <!-- ================================================================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/responsePreviewCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="@color/wl_surface"
        app:strokeWidth="1dp"
        app:strokeColor="@color/wl_divider"
        app:cardElevation="3dp"
        app:layout_constraintBottom_toTopOf="@id/bottomDeckContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <!-- AI Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI"
                    android:textColor="@color/wl_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/streamingIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •••"
                    android:textColor="@color/wl_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/speakingIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  🔊 Speaking"
                    android:textColor="@color/wl_primary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/openChatFromPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat →"
                    android:textColor="@color/wl_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"
                    android:paddingEnd="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open complete chat conversation" />
            </LinearLayout>

            <!-- Latest Response Snippet -->
            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Point camera at an object and hold the microphone to ask."
                android:textColor="@color/wl_text_body"
                android:textSize="14sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================================================================ -->
    <!-- 4. LOWER CONTROL DECK (Wireframe: Search Bar + Morse + Mic + Dropdown) -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/bottomDeckContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 4A. TEXT INPUT COMPOSER ("Search Bar" in Wireframe) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <!-- Normal Input State -->
            <LinearLayout
                android:id="@+id/normalComposerLayout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_composer_field"
                android:paddingStart="16dp"
                android:paddingEnd="6dp">

                <EditText
                    android:id="@+id/questionInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Ask about what you see..."
                    android:textColorHint="@color/wl_text_secondary"
                    android:textColor="@color/wl_text_primary"
                    android:textSize="14sp"
                    android:background="@null"
                    android:maxLines="2"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textShortMessage"
                    android:importantForAccessibility="yes" />

                <!-- Send / Submit Arrow Button -->
                <ImageButton
                    android:id="@+id/sendQuestionButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_send"
                    android:contentDescription="Submit question"
                    app:tint="@color/wl_primary" />
            </LinearLayout>

            <!-- Hold-to-Talk Listening State Overlay -->
            <LinearLayout
                android:id="@+id/listeningComposerLayout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_composer_field"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <com.example.worldlens.ui.RecordingWaveformView
                    android:id="@+id/waveformView"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/listeningPromptText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listening..."
                    android:textColor="@color/wl_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 4B. THREE-ELEMENT BOTTOM ACTION ROW (Morse | Mic | Dropdown) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- LEFT: Morse Action Button (Wireframe: "morse button") -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/playMorseButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="96dp"
                android:text="••• Morse"
                android:textColor="@color/wl_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_button"
                android:paddingHorizontal="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="Play Morse code audio for the current response" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/stopMorseButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="96dp"
                android:text="■ Stop"
                android:textColor="@color/wl_text_on_alert"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_button_stop"
                android:paddingHorizontal="14dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="Stop Morse code audio playback" />

            <!-- CENTER: Circular Press-and-Hold Microphone (Wireframe: "mic") -->
            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_mic_circle"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Hold to speak, release to finish"
                app:tint="@color/wl_text_on_primary"
                android:elevation="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- RIGHT: Dropdown / Quick Actions Button (Wireframe: "drop down") -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/moreActionsButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="90dp"
                android:text="More ▼"
                android:textColor="@color/wl_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_button"
                android:paddingHorizontal="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="Open quick actions menu" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- ================================================================ -->
    <!-- 5. DEDICATED CHAT PANEL SCREEN (Wireframe Right: "Chat and others") -->
    <!-- ================================================================ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wl_background"
        android:visibility="gone"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Chat Header -->
        <LinearLayout
            android:id="@+id/chatHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:background="@color/wl_surface"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/closeChatButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Return to live camera"
                app:tint="@color/wl_icon_tint_dark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Conversation"
                android:textColor="@color/wl_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/newChatPanelButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="+ New Chat"
                android:textColor="@color/wl_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_button"
                android:paddingHorizontal="10dp"
                android:contentDescription="Reset conversation" />
        </LinearLayout>

        <!-- Chat Messages Scroll Area -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/chatScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            app:layout_constraintTop_toBottomOf="@id/chatHeaderLayout"
            app:layout_constraintBottom_toTopOf="@id/chatComposerContainer">

            <LinearLayout
                android:id="@+id/chatMessagesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp" />
        </androidx.core.widget.NestedScrollView>

        <!-- Chat Follow-up Composer at Bottom -->
        <LinearLayout
            android:id="@+id/chatComposerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_composer_field"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:minHeight="50dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <EditText
                android:id="@+id/chatQuestionInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ask a follow-up..."
                android:textColorHint="@color/wl_text_secondary"
                android:textColor="@color/wl_text_primary"
                android:textSize="14sp"
                android:background="@null"
                android:maxLines="3"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textShortMessage"
                android:importantForAccessibility="yes" />

            <ImageButton
                android:id="@+id/chatMicButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_mic_circle"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Hold to speak in chat"
                app:tint="@color/wl_text_on_primary"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/chatSendButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Send follow-up question"
                app:tint="@color/wl_primary" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>