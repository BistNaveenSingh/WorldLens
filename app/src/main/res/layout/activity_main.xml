<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wl_background">

    <!-- MAIN SCROLL VIEW for content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipChildren="false">

            <!-- ============================== -->
            <!-- STATE: CAMERA (Home)           -->
            <!-- ============================== -->
            <LinearLayout
                android:id="@+id/cameraStateContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WorldLens"
                        android:textColor="@color/wl_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/settingsButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_preferences"
                        app:tint="@color/wl_icon_tint" />
                </LinearLayout>

                <!-- Viewfinder -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="@color/wl_surface"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/wl_divider"
                    android:layout_marginBottom="24dp">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/viewFinder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Input Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/rounded_input_bg"
                    android:padding="4dp"
                    android:layout_marginBottom="24dp">

                    <ImageButton
                        android:id="@+id/micButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_btn_speak_now"
                        android:contentDescription="Microphone voice input"
                        app:tint="@color/wl_text_secondary" />

                    <EditText
                        android:id="@+id/questionInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Ask about what you see..."
                        android:textColorHint="@color/wl_text_secondary"
                        android:textColor="@color/wl_text_primary"
                        android:textSize="16sp"
                        android:background="@null"
                        android:paddingEnd="16dp"
                        android:maxLines="1"
                        android:inputType="text"
                        android:importantForAccessibility="yes" />
                </LinearLayout>

                <!-- Analyze Button -->
                <Button
                    android:id="@+id/askButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="✨ Analyze with Gemma"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="32dp"
                    app:backgroundTint="@color/wl_primary"
                    android:textColor="@color/wl_text_on_primary"
                    android:layout_marginBottom="32dp" />

            </LinearLayout>

            <!-- ============================== -->
            <!-- STATE: LOADING                 -->
            <!-- ============================== -->
            <LinearLayout
                android:id="@+id/loadingStateContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingTop="120dp">

                <ProgressBar
                    android:id="@+id/loadingProgressBar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:indeterminateTint="@color/wl_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="UNDERSTANDING IMAGE..."
                    android:textColor="@color/wl_text_secondary"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- ============================== -->
            <!-- STATE: ERROR                   -->
            <!-- ============================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/errorStateContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/wl_surface"
                app:strokeColor="@color/wl_divider"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Could not analyze image.\nPlease try again."
                        android:textColor="@color/wl_text_primary"
                        android:textSize="16sp"
                        android:textAlignment="center"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/retryButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRY AGAIN"
                        android:textColor="@color/wl_primary"
                        app:strokeColor="@color/wl_divider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================== -->
            <!-- STATE: RESULT                  -->
            <!-- ============================== -->
            <LinearLayout
                android:id="@+id/resultStateContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <ImageButton
                        android:id="@+id/backToHomeButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="@color/wl_icon_tint" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Result"
                        android:textAlignment="center"
                        android:textColor="@color/wl_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/deleteScanButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="@color/wl_icon_tint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/questionEchoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Question: What is this?"
                    android:textColor="@color/wl_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- Card 1: AI Answer -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/wl_surface"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/wl_divider">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🤖 AI Answer"
                            android:textColor="@color/wl_primary"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/resultText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textColor="@color/wl_text_primary"
                            android:textSize="16sp"
                            android:lineSpacingExtra="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Morse Summary -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/wl_accent_purple"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💬 Morse Summary"
                            android:textColor="@color/wl_primary"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/morseSummaryText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textColor="@color/wl_text_primary"
                            android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 3: Morse Code -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/wl_surface_variant"
                    app:strokeColor="@color/wl_divider"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚡ Morse Code"
                            android:textColor="@color/wl_text_secondary"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/morseCodeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="..."
                            android:textColor="@color/wl_text_primary"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Primary Action Button -->
                <Button
                    android:id="@+id/playMorseButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="▶ Play Morse"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:backgroundTint="@color/wl_primary"
                    android:textColor="@color/wl_text_on_primary"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/stopMorseButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="■ Stop"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    android:textColor="@color/wl_primary"
                    app:strokeColor="@color/wl_primary"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/readAnswerButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🔊 Read Aloud"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    android:textColor="@color/wl_text_secondary"
                    app:strokeColor="@color/wl_divider"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/openExportStateButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Export &amp; Share"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:backgroundTint="@color/wl_surface_variant"
                    android:textColor="@color/wl_text_primary"
                    android:layout_marginBottom="32dp" />

            </LinearLayout>

            <!-- ============================== -->
            <!-- STATE: EXPORT                  -->
            <!-- ============================== -->
            <LinearLayout
                android:id="@+id/exportStateContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <ImageButton
                        android:id="@+id/backToResultButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="@color/wl_icon_tint" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Export &amp; Share"
                        android:textAlignment="center"
                        android:textColor="@color/wl_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp" /> <!-- Spacer -->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <!-- Copy Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/copyResultCard"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/wl_surface"
                        app:cardCornerRadius="16dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/wl_divider">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📄"
                                android:textSize="32sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Copy to Clipboard"
                                android:textColor="@color/wl_text_primary"
                                android:textStyle="bold"
                                android:textAlignment="center"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Export Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/exportReportCard"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/wl_surface"
                        app:cardCornerRadius="16dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/wl_divider">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📥"
                                android:textSize="32sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Save as Markdown"
                                android:textColor="@color/wl_text_primary"
                                android:textStyle="bold"
                                android:textAlignment="center"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <Button
                    android:id="@+id/newScanButtonFromExport"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Start New Scan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    android:textColor="@color/wl_primary"
                    app:strokeColor="@color/wl_primary"
                    android:layout_marginBottom="32dp" />

            </LinearLayout>
            
            <!-- Accessibility toggle hidden at the very bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/accessibilityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessibility Mode"
                    android:textSize="14sp"
                    android:textColor="@color/wl_text_secondary"
                    android:layout_marginEnd="12dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/accessibilitySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>